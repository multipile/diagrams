// diff: added=3 removed=2 changed=1
diagram dependency version=1 {
  title "How the cli crates depend on one another"
  desc "The pile crate depends on every other crate, and the piles, graph and diagrams crates depend on storage."
  note "A line points from a crate to a crate it depends on."

  box pile pile="@pile" sub="crates/pile"
  box piles pile="@piles" sub="crates/piles"
  box graph pile="@graph" sub="crates/graph"
  box diagrams pile="@diagrams" sub="crates/diagrams" focal=#true
  box storage pile="@storage" sub="crates/storage"

  line pile piles
  line pile graph
  line pile diagrams
  line pile storage
  line piles storage
  line graph storage
  line graph piles
  line diagrams storage
}
